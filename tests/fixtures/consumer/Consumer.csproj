<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <StTropezStageDirectory>$(MSBuildProjectDirectory)/obj/sttropez</StTropezStageDirectory>
    <StTropezTestVersion Condition="'$(StTropezTestVersion)' == ''">0.0.0-local</StTropezTestVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StTropez.Assets" Version="[$(StTropezTestVersion)]" />
  </ItemGroup>
  <Target Name="PrepareFrontend" DependsOnTargets="StTropezPrepareAssets">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/assets-root.txt" Lines="$(StTropezPreparedRoot)" Overwrite="true" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/package-assets-root.txt" Lines="$(StTropezAssetRoot)" Overwrite="true" />
  </Target>
</Project>
