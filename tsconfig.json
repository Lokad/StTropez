{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "incremental": true,
    "tsBuildInfoFile": "artifacts/types/development.tsbuildinfo"
  },
  "include": [
    "fixtures/**/*.ts", "examples/**/*.ts", "examples/**/*.tsx", "tests/**/*.ts", "playwright*.ts",
    "scripts/measurement.mjs", "scripts/browser-harness.mjs",
    "scripts/build.mjs", "scripts/build-demo.mjs", "scripts/finalize-assets.mjs", "scripts/unicode-generation.mjs",
    "scripts/package-host.mjs", "scripts/test-package.mjs", "scripts/run-benchmarks.mjs",
    "scripts/host-scene.mjs", "scripts/serve-demo.mjs", "scripts/inspect.mjs",
    "scripts/benchmark-model.mjs",
    "scripts/benchmark-editing.mjs",
    "scripts/check-docs.mjs", "scripts/documentation-audit.mjs",
    "scripts/generate-grapheme-data.mjs",
    "scripts/benchmark-comparison.mjs", "scripts/benchmark-viewport.mjs"
  ],
  "references": [
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.protocol.json" },
    { "path": "./tsconfig.browser.json" }
  ]
}
