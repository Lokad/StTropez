{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "incremental": true,
    "tsBuildInfoFile": "artifacts/types/development.tsbuildinfo"
  },
  "include": [
    "fixtures/**/*.ts", "examples/**/*.ts", "examples/**/*.tsx", "experiments/**/*.ts", "tests/**/*.ts", "playwright*.ts",
    "scripts/measurement.mjs", "scripts/package-scenarios.mjs", "scripts/browser-harness.mjs",
    "scripts/build.mjs", "scripts/finalize-assets.mjs", "scripts/unicode-generation.mjs", "scripts/package-consumer.mjs", "scripts/package-host.mjs", "scripts/package-react-host.mjs",
    "scripts/run-benchmarks.mjs", "scripts/host-scene.mjs", "scripts/serve-demo.mjs"
  ],
  "references": [
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.protocol.json" },
    { "path": "./tsconfig.browser.json" }
  ]
}
