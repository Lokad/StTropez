{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "sttropez": ["./src/index.ts"],
      "sttropez/browser": ["./src/browser/index.ts"],
      "sttropez/protocol": ["./src/protocol/index.ts"],
      "sttropez/kernels": ["./src/kernels/index.ts"]
    },
    "incremental": true,
    "tsBuildInfoFile": "artifacts/types/development.tsbuildinfo"
  },
  "include": [
    "examples/**/*.ts", "examples/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "playwright*.ts",
    "scripts/**/*.mjs"
  ],
  "references": [
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.protocol.json" },
    { "path": "./tsconfig.browser.json" }
  ]
}
