{
  "name": "sttropez",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "A dependency-free editor foundation for programmable workspaces.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./kernels": {
      "types": "./dist/kernels/index.d.ts",
      "import": "./dist/kernels/index.js"
    },
    "./editor.css": "./dist/editor.css",
    "./regex-worker.js": "./dist/browser/regex-worker.js"
  },
  "scripts": {
    "demo": "node scripts/serve.mjs",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "preview:demo": "node scripts/serve-demo.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/finalize-assets.mjs",
    "pack:nuget": "npm run build && dotnet restore packaging/StTropez.Assets.csproj && dotnet pack packaging/StTropez.Assets.csproj --no-build",
    "test:package": "npm run pack:nuget && node scripts/test-package.mjs",
    "typecheck": "tsc --build",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test \"tests/*.test.ts\" \"tests/integration/*.test.ts\"",
    "test:models": "node --test \"tests/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/*.test.ts\"",
    "test:browser": "playwright test --project=chromium",
    "test:ci": "playwright test --project=chromium --test-list=tests/browser/ci.txt",
    "test:browsers": "playwright test --global-timeout=3600000",
    "browsers:install": "playwright install chromium firefox webkit",
    "inspect": "node scripts/inspect.mjs",
    "bench": "node scripts/run-benchmarks.mjs --group=default",
    "bench:comparison": "node scripts/run-benchmarks.mjs --suite=comparison --",
    "bench:model": "node scripts/run-benchmarks.mjs --suite=model --",
    "bench:viewport": "node scripts/run-benchmarks.mjs --suite=viewport --",
    "bench:editing": "node scripts/run-benchmarks.mjs --suite=editing --",
    "check": "npm run typecheck && npm run check:docs && npm test && npm run build && npm run test:browser",
    "bench:all": "node scripts/run-benchmarks.mjs --group=all"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "typescript-demo": "npm:typescript@5.9.3",
    "typescript-language-server": "5.1.3",
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-uri": "3.1.0",
    "ws": "8.22.2"
  }
}
