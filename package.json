{
  "name": "sttropez",
  "version": "0.0.0",
  "private": true,
  "description": "A dependency-free editor foundation for programmable workspaces.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./editor.css": "./dist/editor.css",
    "./regex-worker.js": "./dist/browser/regex-worker.js"
  },
  "scripts": {
    "demo": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/finalize-assets.mjs",
    "pack:nuget": "npm run build && dotnet restore packaging/StTropez.Assets.csproj && dotnet pack packaging/StTropez.Assets.csproj --no-build",
    "test:package": "node scripts/qualify-package.mjs",
    "test:package:pilot": "node scripts/qualify-package.mjs --scenarios=pilot",
    "bench:package-pilot": "npm run pack:nuget && node scripts/test-package.mjs --pilot-only --bench",
    "test:package:hunk": "node scripts/qualify-package.mjs --scenarios=hunk",
    "bench:package-hunk": "npm run pack:nuget && node scripts/test-package.mjs --hunk-only --bench",
    "test:package:react": "node scripts/qualify-package.mjs --scenarios=react",
    "test:package:lsp": "node scripts/qualify-package.mjs --scenarios=lsp",
    "test:package:activation": "node scripts/qualify-package.mjs --scenarios=activation",
    "test:package:workspace": "node scripts/qualify-package.mjs --scenarios=workspace",
    "bench:package-react": "npm run pack:nuget && node scripts/test-package.mjs --react-only --bench",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.protocol.json",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:browsers": "playwright test --config playwright.all.config.ts",
    "browsers:install": "playwright install chromium firefox webkit",
    "inspect": "node scripts/inspect.mjs",
    "bench": "node scripts/benchmark-model.mjs && node scripts/benchmark-editing.mjs",
    "bench:paragraph": "node --expose-gc scripts/benchmark-paragraph.mjs",
    "bench:bidi": "node scripts/benchmark-bidi.mjs",
    "bench:host-input": "node scripts/benchmark-host-input.mjs",
    "bench:host-folding": "node scripts/benchmark-host-folding.mjs",
    "bench:host-reference": "node scripts/benchmark-host-reference.mjs",
    "bench:host-language": "node scripts/benchmark-host-language.mjs",
    "bench:host-navigation": "node scripts/benchmark-host-navigation.mjs",
    "bench:host-pointer": "node scripts/benchmark-host-pointer.mjs",
    "bench:host-drag-scroll": "node scripts/benchmark-host-drag-scroll.mjs",
    "bench:host-word-selection": "node scripts/benchmark-host-word-selection.mjs",
    "bench:navigation": "node scripts/benchmark-navigation.mjs",
    "bench:hosts": "node scripts/benchmark-hosts.mjs",
    "bench:save-conflicts": "node scripts/benchmark-save-conflicts.mjs",
    "bench:save-recovery": "node scripts/benchmark-save-recovery.mjs",
    "bench:comparison": "node scripts/benchmark-comparison.mjs",
    "bench:model": "node scripts/benchmark-model.mjs",
    "bench:trace": "node scripts/benchmark-trace.mjs",
    "bench:storage": "node scripts/benchmark-storage.mjs",
    "bench:viewport": "node scripts/benchmark-viewport.mjs",
    "bench:editing": "node scripts/benchmark-editing.mjs",
    "bench:services": "node scripts/benchmark-services.mjs",
    "bench:bulk": "node scripts/benchmark-bulk.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "bench:graphemes": "node scripts/benchmark-graphemes.mjs",
    "bench:host-reference-focus": "node scripts/benchmark-host-reference-focus.mjs",
    "bench:host-table-paste": "node scripts/benchmark-host-table-paste.mjs",
    "bench:all": "node scripts/benchmark.mjs && node scripts/benchmark-viewport.mjs && node scripts/benchmark-editing.mjs && node scripts/benchmark-services.mjs && node scripts/benchmark-bulk.mjs && node scripts/benchmark-comparison.mjs && node scripts/benchmark-hosts.mjs && node scripts/benchmark-host-language.mjs && node scripts/benchmark-save-conflicts.mjs && node scripts/benchmark-save-recovery.mjs && node scripts/benchmark-navigation.mjs && node scripts/benchmark-host-navigation.mjs && node scripts/benchmark-host-folding.mjs && node scripts/benchmark-host-table-paste.mjs && node scripts/benchmark-host-pointer.mjs && node scripts/benchmark-host-input.mjs && node scripts/benchmark-host-reference.mjs && node scripts/benchmark-bidi.mjs && node --expose-gc scripts/benchmark-paragraph.mjs && node scripts/benchmark-graphemes.mjs",
    "bench:pilot": "node scripts/benchmark-host-input.mjs && node scripts/benchmark-comparison.mjs && node scripts/benchmark-save-conflicts.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "typescript-demo": "npm:typescript@5.9.3",
    "vscode-languageserver-protocol": "3.17.5",
    "ws": "8.22.2"
  }
}
